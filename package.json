{
  "name": "avaliacao-fhdod",
  "version": "1.1.0",
  "description": "Sistema de avaliação do atendimento para a Fundação Hospitalar Dr. Oswaldo Diesel",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "npm run start --workspace @fhdod/backend",
    "dev": "npm run dev --workspace @fhdod/backend",
    "criar-gerente": "node scripts/database/criar-gerente.js",
    "migrar": "node scripts/database/migrar.js",
    "test": "node --test tests/api/api.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:volume": "node --test tests/integration/relatorios.test.js",
    "test:painel": "node tests/e2e/painel.test.cjs",
    "test:seguranca": "node --test tests/security/seguranca.test.js",
    "lint": "node scripts/checks/verificar-sintaxe.js",
    "monitorar": "node scripts/checks/monitorar.js"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ]
}
