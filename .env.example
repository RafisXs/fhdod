# Copie este arquivo para ".env" e preencha com os seus valores.
# O arquivo ".env" NÃO vai para o GitHub (está no .gitignore).

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospital_experiencia
DB_USER=root
DB_PASSWORD=

# --- Aplicação ---
PORT=3002
NODE_ENV=development

# Texto longo e aleatório, usado para assinar o login. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Use true somente quando o site estiver publicado com HTTPS
COOKIE_SECURE=false

# Opcional: se preenchido, a TV Wall só abre com /tv.html?token=VALOR
TV_TOKEN=

# Opcional: número de proxies à frente do servidor (ex.: 1 atrás de Nginx), para o limite
# de tentativas enxergar o IP real. Deixe em branco rodando localmente.
TRUST_PROXY=
